# The Updawg agent. Installed by install.sh (DAWG-44), and by the packages when
# there are packages (DAWG-42).
[Unit]
Description=Updawg agent
Documentation=https://github.com/Pez-Solutions/updawg-agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/updawgd
# ⚠️ Root, and sandboxed only as far as the package manager can bear (DAWG-43,
# agreed with Pez 2026-09-28). The agent's jobs *are* running apt and dnf, whose
# maintainer scripts can do anything to the system; a restriction they trip on
# makes an install fail in a way that looks like a broken package. What limits
# this process is the closed job set and /etc/updawg/agent.toml, which the
# server can narrow and never widen. These two cost the package managers
# nothing — checked by upgrading and installing and removing packages under
# them on Debian 13 and Rocky 9:
#
# Its own /tmp, so nothing on the host can plant files where it or a
# maintainer script will read them.
PrivateTmp=yes
# The networking a package manager and its scripts use: the gateway and the
# mirrors (inet, inet6), systemd and D-Bus (unix), udev and ip (netlink). Not
# raw packets, not bluetooth, not anything else.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Not set, and on purpose: maintainer scripts run setuid helpers (su, newgrp,
# passwd for adduser) and some postinsts need them. The systemd default,
# spelled out so nobody "fixes" it.
NoNewPrivileges=no
# Not ProtectHome: it would make /root read-only to maintainer scripts and to
# a snapper rollback of files under /root.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
