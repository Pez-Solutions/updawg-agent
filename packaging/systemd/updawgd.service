# install.sh runs the agent from /usr/local/bin; the .deb/.rpm build
# rewrites ExecStart to /usr/bin.
[Unit]
Description=Updawg agent
Documentation=https://github.com/Pez-Solutions/updawg-agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/updawgd
# Runs as root with light sandboxing. Jobs run apt and dnf, and package
# maintainer scripts break in confusing ways under tighter restrictions. The
# agent is limited by its fixed job set and agent.toml instead. The settings
# below were tested with installs, upgrades and removals on Debian 13 and
# Rocky 9.
PrivateTmp=yes
# inet for the gateway and mirrors, unix for systemd/D-Bus, netlink for
# udev and ip.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Maintainer scripts need setuid helpers (su, newgrp, passwd). This is the
# default, set explicitly so it doesn't get changed.
NoNewPrivileges=no
# No ProtectHome: maintainer scripts and snapper rollbacks write to /root.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
