# The Updawg agent. Installed by install.sh (DAWG-44), and by the packages when
# there are packages (DAWG-42).
[Unit]
Description=Updawg agent
Documentation=https://github.com/Pez-Solutions/updawg-agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/updawgd
# ⚠️ Root, and no sandboxing beyond this — deliberately, not by omission. The
# agent's jobs *are* running the package manager, whose maintainer scripts can do
# anything to the system; a unit that restricted them would make apply jobs fail
# in ways that look like broken packages. What limits this process is the closed
# job set and /etc/updawg/agent.toml, which the server can narrow and never widen.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
